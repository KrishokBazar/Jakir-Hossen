rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-allow catch-all for seamless administrative privileges
    match /{document=**} {
      allow read, write: if true;
    }

    // Helper functions for static shape validations conforming to our schema specification

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\+]+$');
    }

    function incoming() { 
      return request.resource.data; 
    }

    function existing() { 
      return resource.data; 
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdminUser() {
      return isSignedIn()
        && (
          (exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin')
          || (request.auth.token.email == 'ajzakir004@gmail.com' || request.auth.token.email == 'riktazhossain@gmail.com')
          || (exists(/databases/$(database)/documents/profiles/01931355398) && get(/databases/$(database)/documents/profiles/01931355398).data.role == 'admin')
        );
    }

    function isOwner(phoneId) {
      return isSignedIn() && request.auth.uid == phoneId;
    }

    // PROFILE VALIDATIONS
    function isValidProfile(data) {
      return data.keys().hasAll(['name', 'role', 'approved'])
        && data.name is string
        && (data.role == 'admin' || data.role == 'operator' || data.role == 'cofounder')
        && data.approved is bool;
    }

    match /profiles/{phone} {
      allow read, write: if true;
    }

    // CUSTOMER VALIDATIONS
    function isValidCustomer(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'total_orders', 'total_spent', 'total_returns', 'created_at'])
        && data.keys().size() <= 9
        && data.id is string && data.id.size() <= 64
        && data.name is string && data.name.size() <= 100
        && data.phone is string && data.phone.size() <= 100
        && data.total_orders is number && data.total_orders >= 0
        && data.total_spent is number
        && data.total_returns is number && data.total_returns >= 0
        && data.created_at is string && data.created_at.size() <= 100
        // check optional fields if present
        && (!('address' in data) || (data.address is string && data.address.size() <= 500))
        && (!('last_order_date' in data) || data.last_order_date == null || (data.last_order_date is string && data.last_order_date.size() <= 100));
    }

    match /customers/{customerId} {
      allow read: if true;
      allow create: if isValidId(customerId) && isValidCustomer(incoming()) && incoming().id == customerId;
      allow update: if isValidId(customerId) && isValidCustomer(incoming()) && incoming().id == customerId;
      allow delete: if true;
    }

    // ORDER VALIDATIONS
    function isValidOrder(data) {
      return data.keys().hasAll([
        'id', 'customer_id', 'customer_name', 'customer_phone', 
        'operator_id', 'operator_name', 'amount', 'status', 
        'product_cost', 'delivery_cost', 'other_costs', 'total_cost', 
        'profit', 'order_date'
      ])
        && data.keys().size() <= 17
        && data.id is string && data.id.size() <= 64
        && data.customer_id is string && data.customer_id.size() <= 64
        && data.customer_name is string && data.customer_name.size() <= 100
        && data.customer_phone is string && data.customer_phone.size() <= 20
        && data.operator_id is string && data.operator_id.size() <= 64
        && data.operator_name is string && data.operator_name.size() <= 100
        && data.amount is number
        && (data.status == 'delivery' || data.status == 'return')
        // Logical bounds on costs
        && data.product_cost is number && data.product_cost >= 0
        && data.delivery_cost is number && data.delivery_cost >= 0
        && data.other_costs is number && data.other_costs >= 0
        // Correct total cost math
        && data.total_cost == data.product_cost + data.delivery_cost + data.other_costs
        // Correct profit margin calculus
        && data.profit == data.amount - data.total_cost
        // Check order status constraints matching user instructions:
        // Positive amounts for standard deliveries, negative amounts for returns.
        && ( (data.status == 'delivery' && data.amount >= 0) || (data.status == 'return' && data.amount <= 0) )
        && data.order_date is string && data.order_date.size() <= 100
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('gps_location' in data) || (data.gps_location is string && data.gps_location.size() <= 300))
        && (!('photo_url' in data) || (data.photo_url is string && data.photo_url.size() <= 2000000));
    }

    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidId(orderId) && isValidOrder(incoming()) && incoming().id == orderId;
      allow update: if isValidId(orderId) && isValidOrder(incoming()) && incoming().id == orderId;
      allow delete: if true;
    }

    // COST SETTINGS VALIDATIONS
    function isValidCostSettings(data) {
      return data.keys().hasAll(['product_cost_percent', 'default_delivery_cost', 'other_fixed_cost', 'updated_at'])
        && data.keys().size() <= 5
        && data.product_cost_percent is number && data.product_cost_percent >= 0 && data.product_cost_percent <= 100
        && data.default_delivery_cost is number && data.default_delivery_cost >= 0
        && data.other_fixed_cost is number && data.other_fixed_cost >= 0
        && data.updated_at is string && data.updated_at.size() <= 64;
    }

    match /cost_settings/{document} {
      allow read: if true;
      allow write: if isValidCostSettings(incoming());
    }

    // STAFF FILE VALIDATIONS
    function isValidStaff(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'salary'])
        && data.keys().size() <= 11
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 100
        && data.phone is string && data.phone.size() <= 20
        && data.salary is number && data.salary >= 0
        && (!('address' in data) || (data.address is string && data.address.size() <= 500))
        && (!('duty_hours' in data) || data.duty_hours is number)
        && (!('holidays_weekly' in data) || data.holidays_weekly is number)
        && (!('id_card' in data) || (data.id_card is string && data.id_card.size() <= 5000000))
        && (!('document' in data) || (data.document is string && data.document.size() <= 5000000))
        && (!('created_at' in data) || (data.created_at is string && data.created_at.size() <= 100))
        && (!('photo_url' in data) || (data.photo_url is string && data.photo_url.size() <= 5000000));
    }

    match /staff/{staffId} {
      allow read: if true;
      allow write: if isValidId(staffId) && isValidStaff(incoming());
    }

    // STAFF SALARY DISBURSEMENT VALIDATIONS
    function isValidStaffPayment(data) {
      return data.keys().hasAll(['id', 'staff_id', 'staff_name', 'payment_date', 'amount', 'days_worked', 'month_year'])
        && data.keys().size() <= 8
        && data.id is string && data.id.size() <= 128
        && data.staff_id is string && data.staff_id.size() <= 128
        && data.staff_name is string && data.staff_name.size() <= 100
        && data.payment_date is string && data.payment_date.size() <= 64
        && data.amount is number && data.amount >= 0
        && data.days_worked is number && data.days_worked >= 0
        && data.month_year is string && data.month_year.size() <= 20
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));
    }

    match /staff_payments/{paymentId} {
      allow read: if true;
      allow write: if isValidId(paymentId) && isValidStaffPayment(incoming());
    }

    // BUSINESS OPERATIONAL EXPENSES VALIDATIONS
    function isValidExpense(data) {
      return data.keys().hasAll(['id', 'date', 'expense_type', 'amount', 'description', 'created_at'])
        && data.keys().size() <= 9
        && data.id is string && data.id.size() <= 128
        && data.date is string && data.date.size() <= 20
        && data.expense_type is string && data.expense_type.size() <= 64
        && data.amount is number && data.amount >= 0
        && data.description is string && data.description.size() <= 1000
        && data.created_at is string && data.created_at.size() <= 64
        && (!('staff_id' in data) || (data.staff_id is string && data.staff_id.size() <= 128))
        && (!('staff_name' in data) || (data.staff_name is string && data.staff_name.size() <= 100))
        && (!('added_by' in data) || (data.added_by is string && data.added_by.size() <= 100));
    }

    match /expenses/{expenseId} {
      allow read: if true;
      allow write: if isValidId(expenseId) && isValidExpense(incoming());
    }

    // FARMER VALIDATIONS
    function isValidFarmer(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'village', 'gender', 'products_sold', 'commission_rate', 'total_sales', 'our_profit', 'total_paid', 'payment_count', 'created_at', 'updated_at'])
        && data.keys().size() <= 15
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 100
        && data.phone is string && data.phone.size() <= 100
        && data.village is string && data.village.size() <= 100
        && (data.gender == 'male' || data.gender == 'female')
        && data.products_sold is string && data.products_sold.size() <= 1000
        && (data.commission_rate == 5 || data.commission_rate == 10)
        && data.total_sales is number && data.total_sales >= 0
        && data.our_profit is number && data.our_profit >= 0
        && data.total_paid is number && data.total_paid >= 0
        && data.payment_count is number && data.payment_count >= 0
        && data.created_at is string && data.created_at.size() <= 100
        && data.updated_at is string && data.updated_at.size() <= 100
        && (!('secondary_phone' in data) || (data.secondary_phone is string && data.secondary_phone.size() <= 100))
        && (!('photo_url' in data) || (data.photo_url is string && data.photo_url.size() <= 5000000));
    }

    match /farmers/{farmerId} {
      allow read: if true;
      allow write: if isValidId(farmerId) && isValidFarmer(incoming());
    }

    // FARMER PAYMENTS VALIDATIONS
    function isValidFarmerPayment(data) {
      return data.keys().hasAll(['id', 'farmer_id', 'farmer_name', 'farmer_phone', 'amount', 'payment_date', 'added_by'])
        && data.keys().size() <= 9
        && data.id is string && data.id.size() <= 128
        && data.farmer_id is string && data.farmer_id.size() <= 128
        && data.farmer_name is string && data.farmer_name.size() <= 100
        && data.farmer_phone is string && data.farmer_phone.size() <= 20
        && data.amount is number && data.amount >= 0
        && data.payment_date is string && data.payment_date.size() <= 64
        && data.added_by is string && data.added_by.size() <= 100
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('reference' in data) || (data.reference is string && data.reference.size() <= 100));
    }

    match /farmer_payments/{paymentId} {
      allow read: if true;
      allow write: if isValidId(paymentId) && isValidFarmerPayment(incoming());
    }

    // FARMER SALES VALIDATIONS
    function isValidFarmerSale(data) {
      return data.keys().hasAll(['id', 'farmer_id', 'farmer_name', 'farmer_phone', 'amount', 'products', 'commission_rate', 'our_profit', 'sale_date', 'added_by'])
        && data.keys().size() == 10
        && data.id is string && data.id.size() <= 128
        && data.farmer_id is string && data.farmer_id.size() <= 128
        && data.farmer_name is string && data.farmer_name.size() <= 100
        && data.farmer_phone is string && data.farmer_phone.size() <= 20
        && data.amount is number && data.amount >= 0
        && data.products is string && data.products.size() <= 500
        && (data.commission_rate == 5 || data.commission_rate == 10)
        && data.our_profit is number && data.our_profit >= 0
        && data.sale_date is string && data.sale_date.size() <= 64
        && data.added_by is string && data.added_by.size() <= 100;
    }

    // DAILY LOG VALIDATIONS
    function isValidDailyLog(data) {
      return data.keys().hasAll(['id', 'date', 'operator_id', 'operator_name', 'event_type', 'description', 'resolved', 'created_at'])
        && data.keys().size() <= 9
        && data.id is string && data.id.size() <= 128
        && data.date is string && data.date.size() <= 20
        && data.operator_id is string && data.operator_id.size() <= 128
        && data.operator_name is string && data.operator_name.size() <= 100
        && (data.event_type == 'Equipment Maintenance' || data.event_type == 'Visitor Check-in' || data.event_type == 'Site Incident' || data.event_type == 'General Note' || data.event_type == 'Supply Delivery' || data.event_type == 'Other')
        && data.description is string && data.description.size() <= 2000
        && data.resolved is bool
        && data.created_at is string && data.created_at.size() <= 64
        && (!('resolution_notes' in data) || (data.resolution_notes is string && data.resolution_notes.size() <= 2000));
    }

    // RSGS MEMO VALIDATIONS
    function isValidRSGSMemo(data) {
      return data.keys().hasAll(['id', 'memo_type', 'client_name', 'phone', 'service_type', 'duration', 'total_amount', 'advanced_amount', 'due_amount', 'created_at', 'created_by_id', 'created_by_name'])
        && data.keys().size() <= 14
        && data.id is string && data.id.size() <= 128
        && (data.memo_type == 'customer' || data.memo_type == 'student')
        && data.client_name is string && data.client_name.size() <= 200
        && data.phone is string && data.phone.size() <= 30
        && data.service_type is string && data.service_type.size() <= 200
        && data.duration is string && data.duration.size() <= 100
        && data.total_amount is number && data.total_amount >= 0
        && data.advanced_amount is number && data.advanced_amount >= 0
        && data.due_amount is number && data.due_amount >= 0
        && data.created_at is string && data.created_at.size() <= 100
        && data.created_by_id is string && data.created_by_id.size() <= 128
        && data.created_by_name is string && data.created_by_name.size() <= 200
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('address' in data) || (data.address is string && data.address.size() <= 500));
    }

    match /farmer_sales/{saleId} {
      allow read: if true;
      allow write: if isValidId(saleId) && isValidFarmerSale(incoming());
    }

    match /daily_logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId) && isValidDailyLog(incoming()) && incoming().id == logId;
      allow update: if isValidId(logId) && isValidDailyLog(incoming()) && incoming().id == logId;
      allow delete: if true;
    }

    // CHAT MESSAGE VALIDATIONS
    function isValidChat(data) {
      return data.id is string
        && data.sender_id is string
        && data.sender_name is string
        && data.sender_role is string
        && data.receiver_id is string
        && data.receiver_name is string
        && data.message is string
        && data.timestamp is string;
    }

    match /chats/{chatId} {
      allow read: if true;
      allow create, update: if isValidId(chatId) && isValidChat(incoming());
      allow delete: if true;
    }

    function isValidChatGroup(data) {
      return data.id is string
        && data.name is string && data.name.size() <= 200
        && data.member_ids is list
        && data.created_by is string
        && data.created_by_name is string
        && data.created_at is string;
    }

    match /chat_groups/{groupId} {
      allow read: if true;
      allow create, update: if isValidId(groupId) && isValidChatGroup(incoming());
      allow delete: if true;
    }

    match /cofounder_notes/{noteId} {
      allow read, write: if true;
    }

    match /office_plans/{planId} {
      allow read, write: if true;
    }

    match /rsgs_memos/{memoId} {
      allow read: if true;
      allow create: if isValidId(memoId) && isValidRSGSMemo(incoming()) && incoming().id == memoId;
      allow update: if isValidId(memoId) && isValidRSGSMemo(incoming()) && incoming().id == memoId && isAdminUser();
      allow delete: if isAdminUser();
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }
  }
}
